{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start-project-protocol.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
